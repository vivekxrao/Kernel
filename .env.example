# Google Cloud project already registered for Google Earth Engine
EE_PROJECT_ID=battle-damage-assessment

# All generated/imported project data is stored here
DATA_DIR=data

# Building-level screening threshold; this is a configurable project choice,
# not a universal or calibrated probability threshold.
DEFAULT_THRESHOLD=3.3

# Local frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Drive folder used when a Drive export fallback is required
EE_EXPORT_FOLDER=KernelBDA
